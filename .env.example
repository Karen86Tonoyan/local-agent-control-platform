# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Audit ---
ALFA_AUDIT_LOG_PATH=./logs/audit.jsonl
ALFA_COMMAND_WHITELIST=echo,pwd,ls

# --- OpenAI / Codex ---
OPENAI_API_KEY=sk-...
OPENAI_GPT_MODEL=gpt-4o
OPENAI_CODEX_MODEL=gpt-4o

# --- Anthropic Claude ---
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-3-5-sonnet-latest

# --- Voice / PRIVATE_ARMENIAN mode ---
VOICE_MODE=PRIVATE_ARMENIAN
ARMENIAN_ACTIVATION=Հայկ
VOICE_LANG=pl-PL
ALT_VOICE_LANG=hy-AM
REQUIRE_CONFIRM_FOR_HIGH_RISK=true
ALLOW_EXEC_AFTER_VOICE=false
VOICE_AUDIT=true
VOICE_MAX_FAILED_ATTEMPTS=3
VOICE_LOCKOUT_SECONDS=300
